{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "t3-office-permission-prototype",
  "main": "worker.ts",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787
  },
  "vars": {
    "APP_ORIGIN": "http://localhost:8787"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "office-permissions-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}

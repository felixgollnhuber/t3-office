{
  "name": "t3-office",
  "version": "0.1.0",
  "private": true,
  "description": "Invitation-based collaborative building for T3 Office, with private agent activity sharing.",
  "keywords": [
    "t3-code",
    "agents",
    "dashboard",
    "three.js",
    "pixel-art",
    "ai-agents",
    "claude-code",
    "codex",
    "visualization",
    "vite"
  ],
  "author": "Felix Gollnhuber",
  "license": "MIT",
  "type": "module",
  "bin": {
    "t3-office": "bin/t3-office.mjs"
  },
  "files": [
    "bin",
    "src",
    "server",
    "public",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "tsconfig.node.json"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node bin/t3-office.mjs --build",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p . && tsc -p tsconfig.node.json && tsc -p cloud/tsconfig.json",
    "add-set": "node scripts/add-set.mjs",
    "test": "node --experimental-strip-types --test server/building.test.ts server/accounting.test.ts server/github-identity.test.ts server/github-login.test.ts server/github-local.test.ts scripts/bridge.test.mjs",
    "bridge": "node scripts/bridge.mjs",
    "serve": "vite preview",
    "test:e2e": "node scripts/ui-input-test.mjs && node scripts/building-view-test.mjs && node scripts/elevator-test.mjs && node scripts/menu-races.mjs && node scripts/smoke.mjs && node scripts/social-test.mjs && node scripts/doorbell-test.mjs && node scripts/humans-test.mjs",
    "local": "node bin/local-office.mjs",
    "demo:friends": "node scripts/friend-preview.mjs",
    "test:social": "node scripts/social-test.mjs",
    "test:tour": "node scripts/friend-preview.mjs --check-tour",
    "test:doorbell": "node scripts/doorbell-test.mjs",
    "test:humans": "node scripts/humans-test.mjs",
    "test:onboarding:recovery": "node scripts/onboarding-recovery-test.mjs",
    "test:onboarding:a11y": "node scripts/onboarding-accessibility-test.mjs",
    "test:onboarding:demo": "node scripts/onboarding-demo-test.mjs",
    "test:ui-input": "node scripts/ui-input-test.mjs",
    "test:github": "node --experimental-strip-types scripts/github-login-test.mjs",
    "test:github:config": "node scripts/github-config-test.mjs",
    "test:onboarding": "npm run test:onboarding:recovery && npm run test:onboarding:a11y && npm run test:tour && npm run test:onboarding:demo",
    "test:cloud": "node scripts/cloud-permissions-test.mjs",
    "cloud:dev": "wrangler dev --local --config cloud/wrangler.jsonc",
    "cloud:migrate:local": "wrangler d1 migrations apply office-permissions-local --local --config cloud/wrangler.jsonc"
  },
  "dependencies": {
    "@fontsource-variable/bitcount-prop-single": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "three": "^0.186.1",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "miniflare": "5.20261102.0-beta",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "wrangler": "4.156.2"
  }
}
